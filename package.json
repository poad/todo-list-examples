{
  "name": "cloudfront-cdn-template",
  "version": "0.1.0",
  "bin": "bin/cloudfront-cdn-template.js",
  "type": "module",
  "scripts": {
    "lint-fix": "pnpm -r --if-present --parallel /^.*-fix$/",
    "lint": "pnpm -r --if-present --parallel /^.*-check$/"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
