{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    "*.{js,jsx,cjs,mjs}",
    "**/*.css",
    "node_modules/**/*",
    ".next",
    "out",
    ".storybook",
    "cdk"
  ],
  "plugins": ["typescript", "react", "promise"],
  "rules": {
    "react-in-jsx-scope": "off",
    "no-underscore-dangle": ["error", {"allow": ["^_"]}]
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  }
}
