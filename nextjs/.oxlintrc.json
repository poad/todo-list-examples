{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    "*.{js,jsx,cjs,mjs}",
    "**/*.css",
    "node_modules/**/*",
    ".next",
    "out",
    ".storybook",
    "cdk",
    "../solidjs",
    "../solidjs/cdk"
  ],
  "plugins": ["typescript", "react", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  }
}
