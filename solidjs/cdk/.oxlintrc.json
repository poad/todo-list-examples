{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    "*.{js,jsx}",
    "src/tsconfig.json",
    "src/stories",
    "**/*.css",
    "node_modules/**/*",
    "out",
    "cdk.out",
    "dist",
    "nextjs"
  ],
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  }
}
